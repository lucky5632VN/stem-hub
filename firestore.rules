rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hàm tiện ích: Kiểm tra người dùng đã đăng nhập hay chưa
    function isAuthenticated() {
      return request.auth != null;
    }

    // Hàm tiện ích: Kiểm tra tài khoản có vai trò Admin hay không
    // 1. Kiểm tra trực tiếp email trong auth token bằng phương thức hợp lệ .lower()
    // 2. Hoặc kiểm tra thuộc tính 'role' trong tài liệu '/users/{uid}'
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'admin123@gmail.com') ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // ==========================================
    // 1. Quy tắc cho Collection: users (Người dùng)
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Chỉ Admin mới được phép xóa người dùng tùy ý.
      // Học sinh chỉ được phép tạo chính tài khoản của mình khi đăng ký.
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
      
      // Admin có toàn quyền cập nhật.
      // Học sinh chỉ được cập nhật các trường của chính mình.
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId
      );
    }

    // ==========================================
    // 2. Quy tắc cho Collection: questions (Ngân hàng câu hỏi)
    // ==========================================
    match /questions/{questionId} {
      // Bất kỳ học sinh nào đã đăng nhập cũng có thể đọc câu hỏi để làm bài thi đấu
      allow read: if isAuthenticated();
      
      // Chỉ Admin mới có quyền tạo mới, cập nhật hoặc xóa câu hỏi trong ngân hàng đề
      allow write: if isAdmin();
    }

    // ==========================================
    // 3. Quy tắc cho Collection: config (Cấu hình hệ thống)
    // ==========================================
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 4. Quy tắc cho Collection: system_alerts (Cảnh báo lỗi)
    // ==========================================
    match /system_alerts/{alertId} {
      // Chỉ Admin mới được phép đọc và ghi log cảnh báo
      allow read, write: if isAdmin();
    }

    // ==========================================
    // 5. Quy tắc cho Collection: match_rooms (Phòng đấu 1v1)
    // ==========================================
    match /match_rooms/{roomId} {
      // Người chơi đã đăng nhập có quyền đọc phòng đấu, tạo phòng mới và xóa phòng đấu (nếu là Admin)
      allow read, create: if isAuthenticated();
      allow delete: if isAdmin();
      
      // Hàm kiểm tra tính hợp lệ của cập nhật tab switches (chỉ cho phép tăng, không cho giảm và chỉ được cập nhật của chính mình)
      function isValidTabSwitchUpdate() {
        let hasP1TabUpdate = request.resource.data.diff(resource.data).affectedKeys().hasAny(['player1TabSwitches']);
        let hasP2TabUpdate = request.resource.data.diff(resource.data).affectedKeys().hasAny(['player2TabSwitches']);
        
        return (!hasP1TabUpdate || (
                 request.auth.uid == resource.data.player1.uid && 
                 (resource.data.player1TabSwitches == null ? request.resource.data.player1TabSwitches > 0 : request.resource.data.player1TabSwitches > resource.data.player1TabSwitches)
               )) &&
               (!hasP2TabUpdate || (
                 request.auth.uid == resource.data.player2.uid && 
                 (resource.data.player2TabSwitches == null ? request.resource.data.player2TabSwitches > 0 : request.resource.data.player2TabSwitches > resource.data.player2TabSwitches)
               ));
      }

      // Hàm kiểm tra tính hợp lệ của status update (chỉ cho phép client chuyển status từ waiting sang playing khi start game)
      function isValidStatusUpdate() {
        let hasStatusUpdate = request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']);
        return !hasStatusUpdate || (resource.data.status == 'waiting' && request.resource.data.status == 'playing');
      }

      // Hàm kiểm tra tính hợp lệ của việc join Player 2 (ngăn chặn học sinh thứ 3 ghi đè cướp slot)
      function isValidPlayer2Update() {
        let hasPlayer2Update = request.resource.data.diff(resource.data).affectedKeys().hasAny(['player2']);
        return !hasPlayer2Update || (
          resource.data.player2 == null &&
          request.resource.data.player2.uid == request.auth.uid
        );
      }

      // Hàm chặn gian lận timeRemaining:
      // Client chỉ được phép ghi timeRemaining MỚI <= timeRemaining HIỆN TẠI (chỉ giảm hoặc giữ nguyên).
      // Điều này ngăn học sinh tự tăng thời gian để câu giờ bất hợp lệ.
      function isValidTimeRemainingUpdate() {
        let hasTimeUpdate = request.resource.data.diff(resource.data).affectedKeys().hasAny(['timeRemaining']);
        return !hasTimeUpdate || (
          resource.data.timeRemaining != null &&
          request.resource.data.timeRemaining <= resource.data.timeRemaining
        );
      }

      // Cập nhật phòng chơi: Cho phép cả hai người chơi trong phòng hoặc Admin cập nhật
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.player1.uid ||
        (resource.data.player2 != null && request.auth.uid == resource.data.player2.uid) ||
        isAdmin()
      );

      // Cho phép đọc/ghi logs hoạt động của trận đấu
      match /actionLogs/{logId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ==========================================
    // 6. Quy tắc cho Collection: moments & stories (STEM Stories)
    // ==========================================
    match /moments/{momentId} {
      allow read, write: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /stories/{storyId} {
      allow read, write: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ==========================================
    // 7. Quy tắc cho Collection: seasons & tournaments (Giải đấu & Mùa giải)
    // ==========================================
    match /seasons/{seasonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // 8. Quy tắc cho Collection: challengeInvites (Lời mời thách đấu 1v1)
    // ==========================================
    match /challengeInvites/{inviteId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // 9. Quy tắc cho Collection: admin_logs (Nhật ký hoạt động Admin)
    // ==========================================
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
