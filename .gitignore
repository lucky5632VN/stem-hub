# =============================================================================
# STEM HUB - PRODUCTION CLEAN .GITIGNORE
# Loại bỏ hoàn toàn dependencies, build artifacts, logs, cache và scratch files
# =============================================================================

# 1. Dependencies & Package Managers
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Next.js & Build Outputs
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# 3. Cloud & Hosting Caches
.vercel/
.firebase/

# 4. Environment Variables & Secret Credentials
.env*
!.env.example
*-firebase-adminsdk-*.json
scripts/recovered_keys.txt
temp_auth_users.json

# 5. Logs & Debug Traces
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firestore-debug.log

# 6. Scratch, Temporary Test Dumps & Test Profiles
scratch/
test_*.json
test_*_storage.json
preview_chunk.js
preview_curl.txt
lab_toan_dist.html
.chrome_cdp_test_profile/

# 7. IDE, OS & System Metadata
.DS_Store
Thumbs.db
*.pem
.vscode/
.cursor/
.impeccable/

# 8. Knowledge Graph Caches
graphify-out/
graphify-repo/

# 9. Large Media, Screen Recordings & Archives
*.mp4
video/
*.zip
*.rar
