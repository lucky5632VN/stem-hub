# ==============================================================================
# STEM HUB - Environment Variables Template
# ==============================================================================
# Sao chép tệp này thành .env.local và điền giá trị tương ứng để chạy cục bộ:
#   cp .env.example .env.local
# LƯU Ý: Tuyệt đối không commit tệp .env.local chứa khóa bảo mật thật lên Git.

# --- 1. Google Gemini AI Engine ---
# Khóa API Google Gemini dùng cho Next.js Server API Routes (/api/lab-toan/..., /api/ai/chat)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Khóa API Gemini phía client (Tùy chọn - chỉ dùng khi không thông qua Server API Route)
NEXT_PUBLIC_GEMINI_API_KEY=

# --- 2. Cloudflare Worker API Gateway (Tùy chọn) ---
# Địa chỉ Worker Gateway làm reverse proxy bảo vệ API Key nếu đã triển khai
NEXT_PUBLIC_API_PROXY_URL=

# --- 3. Firebase Configuration & Emulator ---
# Đặt true nếu chạy cùng Firebase Local Emulator Suite
NEXT_PUBLIC_USE_EMULATOR=false

# --- 4. Server-Side Security Secrets ---
# Khóa xác thực nội bộ cho các API quản trị & nhật ký suy luận AI
ADMIN_SECRET_KEY=YOUR_ADMIN_SECRET_KEY_HERE
INTERNAL_API_SECRET=YOUR_INTERNAL_API_SECRET_HERE
INTERNAL_AI_SECRET=YOUR_INTERNAL_AI_SECRET_HERE

# --- 5. SMTP Email Service (Xác thực Email & Phản hồi liên hệ) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL_HERE@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD_HERE
SMTP_FROM=STEM HUB <noreply@stemhub.edu.vn>
