    "framer-motion": "^12.39.0",
    "html2canvas-pro": "^2.0.4",
    "katex": "^0.18.4",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.184.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.13"
